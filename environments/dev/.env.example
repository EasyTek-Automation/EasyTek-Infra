# .env.example para ambiente DEV
# Permite rodar dev simultaneamente com prod no mesmo host

PORTAINER_DATA_PATH=./environments/dev/portainer
NGINX_DATA_PATH=./environments/dev/nginx/data
NGINX_LETSENCRYPT_PATH=./environments/dev/nginx/letsencrypt

# --- Credenciais de rede para volumes CIFS do ZPP Processor ---
# Usuário e senha do Windows que têm acesso a \\sumare\Comum\manutencao\AMG EASYTEK DATA
ZPP_NETWORK_USER=seu_usuario_windows
ZPP_NETWORK_PASSWORD=sua_senha_windows
