# .env.example para ambiente PROD
PORTAINER_DATA_PATH=./environments/prod/portainer
NGINX_DATA_PATH=./environments/prod/nginx/data
NGINX_LETSENCRYPT_PATH=./environments/prod/nginx/letsencrypt

# --- Credenciais de rede para volumes CIFS do ZPP Processor ---
# Usuário e senha do Windows que têm acesso a \\sumare\Comum\manutencao\AMG EASYTEK DATA
ZPP_NETWORK_USER=seu_usuario_windows
ZPP_NETWORK_PASSWORD=sua_senha_windows
