# .env.example para ambiente LOCAL
PORTAINER_DATA_PATH=./environments/local/portainer
NGINX_DATA_PATH=./environments/local/nginx/data
NGINX_LETSENCRYPT_PATH=./environments/local/nginx/letsencrypt

# --- KPIReport-v2 (DS-10) ---
# Feature flag para /maintenance/kpi-report-v2 (HTML drilldown + PDF + i18n).
# 'true' (default) habilita; 'false' faz layout retornar alerta com link pra v1.
KPI_REPORT_V2_ENABLED=true
