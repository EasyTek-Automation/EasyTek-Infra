# Ignorar arquivos de ambiente locais. Apenas os .env.example devem ser versionados.
.env
*.env
.env.common
# Ignorar dados gerados pelo Nginx Proxy Manager
environments/*/nginx/data/
environments/*/nginx/letsencrypt/

# Ignorar dados gerados pelo Portainer
environments/*/portainer/

# Ignorar dados gerados pelo Node-RED
node-red-config/

# arquivos com credenciais
.env
.env.local
.env.common
environments/*/.env

# diretórios externos
AMG-Data/
Docker-Data/

# volumes do docker
**/node_modules
**/__pycache__

# Override local de desenvolvimento — referencia imagem local amg-webapp-local
# que só existe na máquina do dev. NUNCA deve ir para o remoto.
docker-compose.override.yml

# Runtime do ZPP Processor (dados e logs gerados em execução)
logs/
zpp-data/

# Configuração local do Claude Code
settings.local.json
